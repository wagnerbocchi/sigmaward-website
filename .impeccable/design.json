  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Current shared primary marketing action.",
      "html": "<a href=\"#\" class=\"ds-button ds-primary ds-focus\">Solicitar demonstracao<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:48px;padding:13px 24px;border:1px solid transparent;border-radius:7px;font-family:var(--font-sans);font-size:14px;font-weight:700;text-align:center;text-decoration:none;transition:color 180ms ease,background-color 180ms ease,border-color 180ms ease;}.ds-button svg{flex-shrink:0;}.ds-focus:focus-visible{outline:2px solid var(--color-brand);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-primary{background:var(--color-brand);color:var(--color-brand-ink);}.ds-primary:hover{background:var(--color-brand-hover);}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Current shared secondary marketing action.",
      "html": "<a href=\"#\" class=\"ds-button ds-secondary ds-focus\">Explorar a plataforma</a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:48px;padding:13px 24px;border:1px solid transparent;border-radius:7px;font-family:var(--font-sans);font-size:14px;font-weight:700;text-align:center;text-decoration:none;transition:color 180ms ease,background-color 180ms ease,border-color 180ms ease;}.ds-button svg{flex-shrink:0;}.ds-focus:focus-visible{outline:2px solid var(--color-brand);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-secondary{background:transparent;color:var(--color-text-bright);border-color:var(--color-border-strong);}.ds-secondary:hover{background:var(--color-surface);border-color:var(--color-brand);}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current desktop links; locale and console controls sit alongside.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegacao\"><a class=\"ds-focus\" href=\"#\">Plataforma</a><a class=\"ds-focus\" href=\"#\">Solucoes</a><a class=\"ds-focus\" href=\"#\">Recursos</a><a class=\"ds-focus\" href=\"#\">Empresa</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:30px;min-height:72px;background:var(--color-bg);font-family:var(--font-sans);font-size:14px;}.ds-nav a{padding-block:25px;color:var(--color-text);text-decoration:none;transition:color 180ms ease;}.ds-nav a:hover{color:var(--color-brand);}.ds-focus:focus-visible{outline:2px solid var(--color-brand);outline-offset:5px;}@media(max-width:1100px){.ds-nav{gap:20px;}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
    },
    {
      "name": "Architecture content panel",
      "kind": "card",
      "refersTo": "content-panel",
      "description": "A specimen of the architecture container; adjacent cells share dividers.",
      "html": "<section class=\"ds-panel\"><h3>Contexto compartilhado</h3><p>Deteccao, investigacao e resposta.</p></section>",
      "css": ".ds-panel{padding:26px;border:1px solid var(--color-border);border-radius:12px;background:var(--color-bg-alt);color:var(--color-text);font-family:var(--font-sans);}.ds-panel h3{font-size:18px;font-weight:650;line-height:1.35;letter-spacing:-.02em;color:var(--color-text-bright);margin:0 0 12px;}.ds-panel p{font-size:14px;line-height:1.75;margin:0;}"
    },
    {
      "name": "Detail list",
      "kind": "custom",
      "description": "Divided capability details with SVG checks.",
      "html": "<ul class=\"ds-details\"><li><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>Deteccao com contexto</span></li><li><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>Investigacao e resposta</span></li></ul>",
      "css": ".ds-details{list-style:none;margin:22px 0 0;padding:0;font-family:var(--font-sans);color:var(--color-text);}.ds-details li{display:flex;align-items:start;gap:12px;padding:12px 0;border-bottom:1px solid var(--color-border-soft);font-size:14px;line-height:1.65;}.ds-details svg{flex-shrink:0;margin-top:4px;color:var(--color-brand);}"
    },
    {
      "name": "Operation stage",
      "kind": "custom",
      "refersTo": "operation-node",
      "description": "Selected investigation specimen. The application supplies four-tab navigation, scene state, and measured SVG connections.",
      "html": "<button type=\"button\" class=\"ds-stage ds-focus\" aria-pressed=\"true\"><span class=\"ds-node\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></span><strong>Investigacao</strong><span class=\"ds-summary\">Contexto para cada evento.</span></button>",
      "css": ".ds-stage{border:0;background:transparent;text-align:left;padding-right:18px;font-family:var(--font-sans);cursor:pointer;}.ds-node{width:57px;height:57px;display:grid;place-items:center;border:1px solid #456383;border-radius:50%;color:var(--color-text-bright);background:var(--color-bg);margin-bottom:13px;transition:background-color 180ms ease,border-color 180ms ease;}.ds-stage strong{display:block;font-size:15px;color:var(--color-text-bright);}.ds-summary{display:block;max-width:164px;margin-top:4px;font-size:12px;line-height:1.6;color:var(--color-text-body);}.ds-stage[aria-pressed=\"true\"] .ds-node{background:#0876ee;border-color:#91bfff;outline:3px solid #173a5e;}.ds-stage:hover .ds-node{border-color:var(--color-brand);}.ds-focus:focus-visible{outline:2px solid var(--color-brand);outline-offset:5px;}@media(max-width:600px){.ds-node{width:45px;height:45px;}.ds-node svg{width:20px;height:20px;}.ds-stage strong{font-size:11px;}.ds-summary{display:none;}}@media(prefers-reduced-motion:reduce){.ds-node{transition:none;}}"
    },
    {
      "name": "Illustrative event row",
      "kind": "custom",
      "refersTo": "event-row-selected",
      "description": "Selected example event; application selection updates the adjacent live-region evidence. This specimen is illustrative, not telemetry.",
      "html": "<button type=\"button\" class=\"ds-event ds-focus\" aria-pressed=\"true\"><time>10:24</time><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H5v20h14V7zM14 2v5h5M8 11h8M8 15h8M8 18h5\"/></svg><span><strong>Evento ilustrativo</strong><small>192.0.2.10</small></span></button>",
      "css": ".ds-event{display:grid;grid-template-columns:35px 21px minmax(0,1fr);gap:9px;align-items:start;width:100%;min-height:44px;padding:6px;text-align:left;border:1px solid transparent;border-radius:8px;color:var(--color-text);font-family:var(--font-sans);background:transparent;cursor:pointer;transition:background-color 180ms ease,border-color 180ms ease;}.ds-event time{font-size:10px;color:var(--color-text-muted);font-variant-numeric:tabular-nums;}.ds-event strong{display:block;font-size:10.5px;font-weight:600;line-height:1.4;color:var(--color-text-bright);}.ds-event small{display:block;color:var(--color-text-muted);font-size:10px;line-height:1.5;margin-top:3px;overflow-wrap:anywhere;}.ds-event[aria-pressed=\"true\"]{background:#1a314d;border-color:#244665;}.ds-event:hover{background:#172a3e;}.ds-focus:focus-visible{outline:2px solid var(--color-brand);outline-offset:5px;}@media(max-width:600px){.ds-event{min-height:55px;grid-template-columns:40px 22px minmax(0,1fr);gap:11px;padding:10px 7px;}.ds-event strong{font-size:12px;}.ds-event small,.ds-event time{font-size:11px;}}@media(prefers-reduced-motion:reduce){.ds-event{transition:none;}}"
    },
    {
      "name": "Agent capability link",
