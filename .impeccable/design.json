  "narrative": {
    "northStar": "Observatorio de seguranca",
    "overview": "The real security product leads a precise, restrained presentation. Dark graphite surfaces, pale blue actions, Manrope typography, and quiet dividers carry the approved application identity into the marketing website.\n\nThe owner approved this replacement world on 2026-11-01: a dark centered homepage combined with the agent-to-response flow. The centered composition belongs to that surface; the durable system is readable hierarchy, authentic product evidence, and clear access to deeper evaluation pages. Components are flat, softly rounded, and explicit about their interactive state.",
    "keyCharacteristics": [
      "Dark graphite with pale blue actions and visible focus.",
      "Manrope for headings, narrative, navigation, and controls.",
      "Thin dividers and tonal surfaces instead of decorative elevation.",
      "Official application logo and real anonymized product captures."
    ],
    "rules": [
      {
        "name": "The Application Identity Rule",
        "body": "Use pale blue for website actions and selection; preserve the official logo colors inside the supplied asset.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate content with tonal backgrounds, spacing, and thin borders; the current system has no drop shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the current website tokens and self-hosted Manrope.",
      "Do preserve the official application logo geometry and its uncropped wordmark.",
      "Do use real anonymized captures, honest captions, and full-size access.",
      "Do retain visible focus, keyboard-operable tabs, reduced-motion support, and mobile navigation.",
      "Do keep Portuguese and English layouts equally readable."
    ],
    "donts": [
      "Don't turn screenshot metrics into live measurements, guarantees, or invented performance claims.",
      "Don't recolor real product captures or replace them with fabricated dashboards.",
      "Don't revive the previous teal action palette, uppercase eyebrows, glow effects, or obsolete card styling.",
      "Don't invent input, chip, or modal patterns that the current website does not contain."
    ]
